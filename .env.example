# Supabase
# URL e anon key: painel do projeto > Settings > API. São públicas por design
# (protegidas por RLS), por isso levam o prefixo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: NUNCA prefixar com NEXT_PUBLIC_. Usada apenas em código
# de servidor (Route Handlers, Server Actions) — ignora RLS.
SUPABASE_SERVICE_ROLE_KEY=

# IA (Anthropic) — chamada apenas no servidor.
ANTHROPIC_API_KEY=
# Opcional: sobrescreve os modelos usados na extração de intenção e na
# composição de looks. Ambos usam claude-opus-5 por padrão se omitidos.
# ANTHROPIC_MODEL_INTENT=claude-opus-5
# ANTHROPIC_MODEL_COMPOSE=claude-opus-5

# Rate limiting (Upstash Redis) — opcional no MVP, necessário antes de produção.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Lomadee (rede de afiliados — produtos reais de várias lojas). Opcional: sem
# essa chave, o app funciona só com o catálogo demo.
LOMADEE_API_KEY=
